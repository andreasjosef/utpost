{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "web",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,client -c blue,green,magenta \"npm run dev --workspace=api\" \"npm run dev --workspace=web\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=api",
    "lint": "npm run lint --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "build": "npm run build --workspace=client",
    "db:up": "bash scripts/db.sh up -d",
    "db:down": "bash scripts/db.sh down",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=api",
    "mongo:smoke": "npm run mongo:smoke --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
