{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "web",
    "client",
    "shared"
  ],
  "scripts": {
    "start": "bash scripts/compose.sh up --build -d",
    "stop": "bash scripts/compose.sh down",
    "dev": "npm run db:up && concurrently -n api,web,client -c blue,green,magenta \"npm run dev --workspace=api\" \"npm run dev --workspace=web\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=api",
    "lint": "npm run lint --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "test:api": "npm run test --workspace=api",
    "build": "npm run build --workspace=client",
    "db:up": "bash scripts/compose.sh up -d postgres mongo",
    "db:down": "bash scripts/compose.sh down",
    "typecheck": "npm run codegen --workspace=client && npm run typecheck --workspace=client && npm run typecheck --workspace=api",
    "mongo:smoke": "npm run mongo:smoke --workspace=api",
    "migrate:logs": "npm run migrate:logs --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
