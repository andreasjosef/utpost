{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @utpost/api dev\" \"pnpm --filter @utpost/web dev\"",
    "dev:api": "pnpm --filter @utpost/api dev",
    "dev:web": "pnpm --filter @utpost/web dev",
    "seed": "pnpm --filter @utpost/api seed",
    "db:up": "bash scripts/db.sh up -d",
    "db:down": "bash scripts/db.sh down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
